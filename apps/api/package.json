    "@fastify/rate-limit": "^9.0.0",
    "@fastify/websocket": "^10.0.0",
    "bcrypt": "^5.1.0",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.30.0",
    "fastify": "^4.26.0",
    "google-auth-library": "^10.6.1",
    "ioredis": "^5.3.0",
    "meilisearch": "^0.38.0",
    "nanoid": "^5.0.0",
    "pino": "^8.19.0",
    "pino-pretty": "^11.0.0",
